# Copia este archivo a .env y llena los valores.
# .env NUNCA se sube a git (ya esta en .gitignore).

# Motor de IA. Consiguela en https://console.anthropic.com
# Creala DENTRO de un workspace, no a nivel organizacion.
ANTHROPIC_API_KEY=sk-ant-...

# Inventario de RedNorte (la misma llave que ya usa Vercel en api/propiedades.js)
NOCNOK_API_KEY=

# Correo desde el que Athena le avisa al asesor de un prospecto nuevo.
# En Gmail NO uses tu contrasena normal: crea una "contrasena de aplicacion"
# en https://myaccount.google.com/apppasswords
SMTP_USUARIO=
SMTP_PASSWORD=

# WhatsApp Business (Meta) para avisarle al asesor por WhatsApp.
# Se sacan de developers.facebook.com > tu app > WhatsApp > API Setup.
# Ojo: el token temporal de prueba dura 24 horas; el permanente sale de
# crear un usuario de sistema en Business Settings.
WHATSAPP_TOKEN=
WHATSAPP_TELEFONO_ID=

# Puerto local del servidor
INMOBOT_PUERTO=8100
