# Copia este archivo a .env y llena los valores.
# .env NUNCA se sube a git (ya esta en .gitignore).

# Motor de IA. Consiguela en https://console.anthropic.com
# Creala DENTRO de un workspace, no a nivel organizacion.
ANTHROPIC_API_KEY=sk-ant-...

# Inventario de RedNorte. Hoy Athena NO lo necesita: lee por el canal del
# propio sitio (ATHENA_TOKEN). Esta llave solo hace falta si un inquilino
# usa el adaptador 'nocnok' directo.
NOCNOK_API_KEY=

# Correo desde el que Athena le avisa al asesor de un prospecto nuevo.
# En Gmail NO uses tu contrasena normal: crea una "contrasena de aplicacion"
# en https://myaccount.google.com/apppasswords
SMTP_USUARIO=
SMTP_PASSWORD=

# Canal que el sitio del cliente abre para Athena. El mismo valor va en
# las variables de entorno del sitio (en RedNorte, en Vercel).
ATHENA_TOKEN=

# WhatsApp Business (Meta): para avisarle al asesor Y para que la IA
# conteste los mensajes que entran.
# Se sacan de developers.facebook.com > tu app > WhatsApp > API Setup.
# Ojo: el token temporal de prueba dura 24 horas; el permanente sale de
# crear un usuario de sistema en Business Settings.
WHATSAPP_TOKEN=
WHATSAPP_TELEFONO_ID=

# Para RECIBIR mensajes. El webhook queda abierto a internet, asi que
# estas dos son lo unico que separa a Meta de cualquier otro que lo
# encuentre:
#   META_VERIFY_TOKEN  lo inventas tu, y lo tecleas igual en Meta al dar
#                      de alta la direccion del webhook.
#   META_APP_SECRET    lo da Meta en tu app > Configuracion > Basica.
META_VERIFY_TOKEN=
META_APP_SECRET=

# Puerto local del servidor
INMOBOT_PUERTO=8100
